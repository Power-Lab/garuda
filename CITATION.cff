    given-names: "Kaarthigeswaran A"
    # orcid: "https://orcid.org/0000-0000-0000-0000"
  - name: "Power Transformation Lab"
keywords:
  - energy systems modeling
  - capacity expansion
  - optimization
  - unit commitment
  - Indonesia
